# Go
/dockercmd
/dist-bin/
*.test
*.out

# Packaging (nfpm output + the build-time-generated systemd unit)
/out/
*.deb
*.rpm
deploy/packaging/dockercmd.service

# Frontend
web/node_modules/
# Anywhere, not just web/: running a frontend tool from the repo root (vitest, say)
# creates a node_modules/.vite cache here, and a path-specific rule let one of those
# files get committed once already.
node_modules/
# Screenshot generator deps (see scripts/screenshots/README.md)
scripts/screenshots/node_modules/
scripts/screenshots/package-lock.json
# tsc -b incremental cache: regenerated on every build, no value in tracking it.
web/tsconfig.tsbuildinfo
# NOTE: web/dist (the built SPA) is committed on purpose so that `go build`
# produces a fully working binary even without Node installed. Rebuild it with
# `npm run build` (or `make ui`) whenever the frontend changes, then commit.

# Local data / secrets
*.db
*.db-wal
*.db-shm
.docker-commander/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Scratch folder for screenshots waiting to be sorted into docs/images/.
.screens/

# Throwaway git worktrees. .claude/skills/ IS tracked; this is transient scaffolding
# that would otherwise be swept up by `git add -A`.
.claude/worktrees/
